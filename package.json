    "ajv-formats": "^3.0.1",
    "cli-args-parser": "^1.0.6",
    "graphql": "^17.0.1",
    "jose": "^6.2.2",
    "js-yaml": "^4.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "ws": "^8.21.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "marked": "^18.0.5",
    "prismjs": "^1.30.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@toon-format/toon": "^2.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.9.3",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "fastest-validator": "^1.19.1",
    "joi": "^18.2.3",
    "jsdom": "^29.1.1",
    "recker": "^1.0.86",
    "serve": "^14.2.6",
    "tuiuiu.js": "^1.0.64",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@toon-format/toon": "^2.0.0",
    "fastest-validator": "^1.17.0",
    "joi": "^17.0.0",
    "yup": "^1.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@toon-format/toon": {
      "optional": true
    },
    "fastest-validator": {
      "optional": true
    },
    "joi": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
